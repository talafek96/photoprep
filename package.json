{
  "name": "photoprep",
  "version": "0.6.1",
  "description": "Local, GUI-first workshop for prepping photos to post: frame landscapes (stack / pano-split) and watermark them. Runs as an app in your browser; scriptable for automation.",
  "keywords": [
    "photo",
    "watermark",
    "instagram",
    "carousel",
    "panorama",
    "collage",
    "batch"
  ],
