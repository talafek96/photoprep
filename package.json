  "author": "Tal Afek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talafek96/photoprep.git"
  },
  "homepage": "https://github.com/talafek96/photoprep#readme",
  "bugs": {
    "url": "https://github.com/talafek96/photoprep/issues"
  },
  "type": "commonjs",
  "bin": {
    "photoprep": "bin/cli.js"
  },
  "main": "src/server.js",
  "files": [
    "bin",
    "src",
    "web",
    "assets",
    "config",
    "launchers",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node test/smoke.js && node test/cli.js && node test/pages.js && node test/plugin.js"
  },
